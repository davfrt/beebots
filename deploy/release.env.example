RELEASE=v2026.10.04
ENGINE_IMAGE=ghcr.io/imikerussell/beebots-engine@sha256:replace-with-release-manifest-digest
WEB_IMAGE=ghcr.io/imikerussell/beebots-web@sha256:replace-with-release-manifest-digest
BACKUP_IMAGE=ghcr.io/imikerussell/beebots-backup@sha256:replace-with-release-manifest-digest
PUBLIC_DOMAIN=bees.example.com
# Keep these outside this manifest; they identify the encrypted off-host backup destination.
BACKUP_AGE_RECIPIENT=age1replace-with-off-host-public-key
BACKUP_SSH_TARGET=backup@backup.example.com:/srv/beebots
BACKUP_SSH_KEY_FILE=/etc/beebots/backup_ssh_key
BACKUP_SSH_KNOWN_HOSTS_FILE=/etc/beebots/backup_known_hosts
